BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# AdminサーバーのURLを設定してください
ADMIN_URL=http://localhost:3001
# Langfuse設定（プロンプト管理・LLM監視）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# AI Chatの日次コストリミット（USD）
CHAT_DAILY_COST_LIMIT_USD=
